# ---------------------------------------------------------------
# Dados clínicos — MIMIC-IV é dado credenciado (DUA do PhysioNet).
# NADA em data/ pode ser versionado, em nenhuma hipótese.
# Âncora "/data/" ao raiz: sem a barra inicial, o padrão também
# bloquearia qualquer subpasta chamada "data" em outro lugar do
# repositório (ex.: src/cardiofusion/data/), que é código, não dado.
# ---------------------------------------------------------------
# Ignora TODO o conteúdo de data/, mas preserva a estrutura de pastas no
# repositório através dos .gitkeep. A regra é sobre o conteúdo (`/data/*`) e
# não sobre o diretório (`/data/`): o git não permite reincluir um arquivo se
# o diretório-pai está excluído, então excluir `/data/` bloquearia até os
# .gitkeep.
/data/*
!/data/.gitkeep
!/data/README.md
!/data/*/
/data/*/*
!/data/*/.gitkeep
!/data/*/*/
/data/*/*/*
!/data/*/*/.gitkeep

*.csv
*.parquet
*.dcm

# ---------------------------------------------------------------
# Artefatos de modelo — saída, não entrada, e por isso fora de data/.
# São regeneráveis por `cardiofusion-train`, e o .joblib é um pickle
# binário preso à versão do scikit-learn que o gerou. O repositório
# guarda a receita; o resultado se refaz em um comando.
# ---------------------------------------------------------------
/models/*
!/models/.gitkeep
!/models/README.md

# ---------------------------------------------------------------
# Conteúdo ainda não liberado para publicação.
# Revisar caso a caso antes de remover destas linhas.
# Também ancorado ao raiz, pelo mesmo motivo acima.
# ---------------------------------------------------------------
/docs/
/reports/
/references/
*.pdf
*.docx
*.pptx

# ---------------------------------------------------------------
# Notas de sessão / plugins de agente — nunca vão para o repo
# ---------------------------------------------------------------
.remember/
.claude/
.superpowers/
.agents/
skills-lock.json
AGENTS.md
CLAUDE.md
*.local.md

# ---------------------------------------------------------------
# Anotações pessoais de como o código funciona — não é entregável
# ---------------------------------------------------------------
/code-notes/

# ---------------------------------------------------------------
# Python / Jupyter
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.env
# metadados gerados por `pip install -e .` — build, não fonte
*.egg-info/
build/
dist/
# caches de ferramenta
.pytest_cache/
.ruff_cache/

# ---------------------------------------------------------------
# Sistema / editores
# ---------------------------------------------------------------
.vscode/
.DS_Store
.~lock.*#
*~

# ---------------------------------------------------------------
# Explicações pessoais dos resultados — material de estudo, não entregável
# ---------------------------------------------------------------
/explanations/

